{
  "name": "blindfeed",
  "version": "0.1.0",
  "private": true,
  "description": "Chrome extension to hide engagement counts and blur identities on X",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:popup": "vite build --config vite.popup.config.ts",
    "build:content": "vite build --config vite.content.config.ts",
    "build": "npm run build:popup && npm run build:content",
    "test": "vitest run"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.308",
    "@types/node": "^22.13.9",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vitest": "^3.0.7"
  }
}
